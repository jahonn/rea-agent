{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jahonn/rea-agent/schemas/investigation-record.schema.json",
  "title": "REA Agent investigation record",
  "type": "object",
  "required": ["schemaVersion", "target", "authorization", "findings", "limitations", "unknowns"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "target": {
      "type": "object",
      "required": ["name", "type", "locator"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 }
      }
    },
    "authorization": {
      "type": "object",
      "required": ["status", "ownership", "purpose", "outputScope", "disclaimerAccepted", "confirmedAt"],
      "properties": {
        "status": { "enum": ["pending", "confirmed", "rejected"] },
        "ownership": { "type": "string" },
        "purpose": { "type": "string" },
        "outputScope": { "type": "string" },
        "disclaimerAccepted": { "type": "boolean" },
        "confirmedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "confidence", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["observed", "inferred", "speculative"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["artifactPath", "summary"],
              "properties": {
                "artifactPath": { "type": "string", "minLength": 1 },
                "locator": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
                "summary": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
